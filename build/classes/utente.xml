<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
 PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
 "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

 <mapper namespace="it.exolab.mapper.UtenteMapper">
 
 	<insert id="insert" parameterType="it.exolab.model.Utente">
 		
 		INSERT INTO utenti(nome,email) VALUES (#{nome},#{email})
 	
 	</insert>
 
 	<select id="findByEmail" resultMap="utenteMap">
 	
 		SELECT * FROM utenti WHERE email = #{email}
 	
 	</select>
 	
 	<resultMap id="utenteMap" type="it.exolab.model.Utente">
 	
 		<result property="email" column="email"/>
 	
 	</resultMap>
 
 </mapper>